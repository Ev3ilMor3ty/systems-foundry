int is_prime(int n) {
    if (n < 2) { return 0; }
    int divisor = 2;
    while (divisor * divisor <= n) {
        if (n % divisor == 0) { return 0; }
        divisor = divisor + 1;
    }
    return 1;
}

int main() {
    print("Primes below 100:");
    int n = 2;
    while (n < 100) {
        if (is_prime(n)) { print(n); }
        n = n + 1;
    }
    return 0;
}

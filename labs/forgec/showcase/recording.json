  "source": "// Integer fixed-point Mandelbrot. Each coordinate has a scale of 256.\nint main() {\n    int y = -12;\n    while (y < 12) {\n        int x = -40;\n        while (x < 40) {\n            int cx = x * 256 / 24 - 128;\n            int cy = y * 256 / 12;\n            int zx = 0;\n            int zy = 0;\n            int iterations = 0;\n            while (zx * zx + zy * zy < 262144 && iterations < 32) {\n                int next_x = zx * zx / 256 - zy * zy / 256 + cx;\n                zy = 2 * zx * zy / 256 + cy;\n                zx = next_x;\n                iterations = iterations + 1;\n            }\n            if (iterations == 32) { put(35); }\n            else if (iterations > 12) { put(43); }\n            else if (iterations > 5) { put(46); }\n            else { put(32); }\n            x = x + 1;\n        }\n        put(10);\n        y = y + 1;\n    }\n    return 0;\n}\n",
